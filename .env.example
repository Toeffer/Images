# Kopiere diese Datei nach ".env" und trage deine API-Schlüssel ein.
# Alternativ lassen sich die Schlüssel bequem in Bildwerk unter ⚙ Einstellungen speichern.
# Es genügt ein Anbieter.

# OpenAI (GPT Image) – https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (Nano Banana) – https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stability AI (Stable Image, Hochskalieren) – https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# Optional: Speicher für „Rückgängig“ je Bild in MB (Standard 768)
# BILDWERK_HISTORY_MB=768
